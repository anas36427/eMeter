# ================================================================
# eMeter AMU — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# ================================================================

# ─── Django Core ─────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Set to False in production ALWAYS
DEBUG=False

# Comma-separated list of allowed hostnames (no wildcards in production)
# Example: your-service.onrender.com,your-custom-domain.com
ALLOWED_HOSTS=your-service.onrender.com

# ─── Database (Neon PostgreSQL) ───────────────────────────────
# Preferred: Use the full DATABASE_URL from Neon dashboard
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/emeter_db?sslmode=require

# Alternative: Individual connection parameters (used if DATABASE_URL is not set)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=emeter_db
DB_USER=emeter_user
DB_PASSWORD=your-database-password
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432

# ─── CORS (Frontend URL on Vercel) ───────────────────────────
# Add your Vercel deployment URL here (comma-separated if multiple)
CORS_ALLOWED_ORIGINS_EXTRA=https://your-app.vercel.app

# ─── Twilio SMS (optional) ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
